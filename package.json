{
  "name": "vc-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && bash scripts/run-e2e.sh",
    "db:seed": "tsx scripts/seed.ts",
    "sources:sync": "node --env-file-if-exists=.env.local --import tsx scripts/sync-sources.ts",
    "collect:rss": "node --env-file-if-exists=.env.local --import tsx scripts/collect-feed.ts",
    "search:web": "node --env-file-if-exists=.env.local --import tsx scripts/search-web.ts",
    "deepseek:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-deepseek.ts",
    "research:deepseek": "node --env-file-if-exists=.env.local --import tsx scripts/research-project-deepseek.ts",
    "agent:sync": "node --env-file-if-exists=.env.local --import tsx scripts/run-background-agent.ts --sync-only",
    "agent:once": "node --env-file-if-exists=.env.local --import tsx scripts/run-background-agent.ts --once",
    "agent:run": "node --env-file-if-exists=.env.local --import tsx scripts/run-background-agent.ts",
    "agent:status": "node --env-file-if-exists=.env.local --import tsx scripts/background-agent-status.ts",
    "intelligence:validate": "node --import tsx scripts/validate-intelligence-bundle.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-xml-parser": "5.11.1",
    "ipaddr.js": "2.5.0",
    "kysely": "0.28.17",
    "lucide-react": "^1.40.0",
    "mammoth": "^1.12.2",
    "next": "16.3.3",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.30.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "26.1.0",
    "kysely-pglite": "^0.6.1",
    "postcss": "^8.5.27",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  }
}
