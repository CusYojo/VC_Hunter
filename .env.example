# Optional. Defaults to .data/vc-hunter.db in the current project.
VC_HUNTER_DB_PATH=/absolute/path/to/vc-hunter.db

# ── Model gateway (multi-provider) ────────────────────────────────
# provider: "deepseek" (default) or "openai_compatible" (OpenAI / 通义 DashScope / Kimi / 豆包 Ark 等)
# MODEL_PROVIDER=deepseek
# MODEL_NAME=deepseek-v4-flash
# MODEL_BASE_URL=https://api.deepseek.com/chat/completions

# DeepSeek key (used when MODEL_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# Versioned Agent runtime composition. Defaults to config/runtime.local.json.
# VC_HUNTER_RUNTIME_CONFIG=/absolute/path/to/runtime.local.json

# Optional Exa search provider. Select it in runtime.local.json only after setting this key.
# EXA_API_KEY=

# For openai_compatible: set MODEL_PROVIDER=openai_compatible and one of:
# OPENAI_API_KEY=
# MODEL_API_KEY=           # generic override, used when OPENAI_API_KEY is unset
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# MODEL_NAME=qwen-plus

# DeepSeek Responses API 的内置 web_search 同时用于外部网络搜索，无需额外搜索服务密钥。

# Skill HTTP execution is disabled and remains fail-closed until the server-side
# tenant/evidence policy resolver is implemented. Background workflows are unaffected.
